// Datenmodell der Rechnungs- und Verwaltungssoftware
// Geldbeträge werden konsequent als Ganzzahl in Cent gespeichert (keine Fließkomma-Rundungsfehler).
// Datenbank: PostgreSQL (Mehrbenutzerbetrieb/Produktion - siehe docker-compose.yml).
// Für rein lokale Kurztests ohne Docker kann provider/DATABASE_URL wieder auf
// SQLite gestellt werden, dafür dann aber eine neue Migration erzeugen
// (siehe docs/INSTALL.md) - Migrations-SQL ist provider-spezifisch, nicht portabel.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Mandantenfähigkeit ----------

model Company {
  id            String   @id @default(uuid())
  name          String
  legalForm     String?
  street        String?
  postalCode    String?
  city          String?
  country       String   @default("DE")
  taxId         String? // Steuernummer
  vatId         String? // USt-IdNr.
  isSmallBusiness Boolean @default(false) // Kleinunternehmerregelung §19 UStG
  defaultVatRateBps Int   @default(1900) // 19.00% in Basispunkten (bps = 1/100 Prozent)
  iban          String?
  bic           String?
  bankName      String?
  // Kontakt- und Registerangaben für Briefkopf/Fußzeile der PDFs. Für Kapitalgesellschaften
  // sind Rechtsform, Sitz, Registergericht, Handelsregisternummer und Geschäftsführer auf
  // Geschäftsbriefen und Rechnungen Pflicht (§35a GmbHG, §80 AktG, §37a HGB für e.K.).
  phone         String?
  email         String?
  website       String?
  registerCourt String? // z.B. "Amtsgericht Berlin (Charlottenburg)"
  registerNumber String? // z.B. "HRB 123456"
  managingDirector String? // Geschäftsführer/Inhaber, bei mehreren kommagetrennt
  // Standard-Zahlungsziel in Tagen: wird beim Anlegen einer Rechnung als Fälligkeitsdatum
  // vorbelegt, wenn keines angegeben wurde.
  paymentTermDays Int     @default(14)
  // Kalkulation (z.B. 3D-Druck): Maschinen- und Arbeitsstundensatz in Cent, Materialausschuss und gewünschter
  // Gewinnaufschlag in Prozent - daraus berechnet die Produktverwaltung Selbstkosten und einen Preisvorschlag.
  machineRateCentsPerHour Int   @default(0)
  laborRateCentsPerHour   Int   @default(0)
  materialWastePercent    Float @default(5)
  targetMarginPercent     Float @default(30)
  // Strompreis (Cent pro kWh) und Gemeinkosten-Aufschlag in Prozent (Miete, Software, Versicherung, Fehldruck-Risiko ...)
  electricityCentsPerKwh  Float @default(35)
  overheadPercent         Float @default(5)
  // Fehldruckquote (Prozentaufschlag auf Strom, Abschreibung und Verschleiß), Plattform-/Zahlungsgebühren (Prozent vom
  // Verkaufspreis), Rundung des Preisvorschlags (NONE, 5, 10, 50, 100 = auf volle Cent-Schritte aufrunden, 90/99 = Preis endet auf ,90/,99)
  // und Mindestpreis je Einheit in Cent.
  // Darstellung der Oberfläche: Akzentfarbe (#rrggbb) und Stil des dunklen Designs ("warm" oder "cool")
  uiAccent                String @default("#2563eb")
  uiDarkStyle             String @default("warm")
  failRatePercent         Float  @default(5)
  platformFeePercent      Float  @default(0)
  priceRounding           String @default("NONE")
  minPriceCents           Int    @default(0)
  // Mahnwesen: Mahngebühren (Auslagenersatz) je Stufe in Cent, Basiszinssatz der Bundesbank in Prozent (ändert sich
  // halbjährlich - bitte aktuell halten), Zahlungsfrist je Mahnung in Tagen und die Texte der drei Stufen.
  dunningFee2Cents        Int   @default(500)
  dunningFee3Cents        Int   @default(1000)
  baseInterestRatePercent Float @default(1.27)
  dunningDeadlineDays     Int   @default(7)
  dunningText1            String @default("Sehr geehrte Damen und Herren,\n\nbei der Durchsicht unserer Buchhaltung ist uns aufgefallen, dass die Rechnung {nummer} noch nicht beglichen wurde. Bitte überweisen Sie den offenen Betrag bis zum {faellig}.\n\nSollten Sie bereits gezahlt haben, betrachten Sie dieses Schreiben bitte als gegenstandslos.\n\nMit freundlichen Grüßen\n{firma}")
  dunningText2            String @default("Sehr geehrte Damen und Herren,\n\ntrotz unserer Zahlungserinnerung konnten wir bisher keinen Zahlungseingang zur Rechnung {nummer} feststellen. Wir bitten Sie, den offenen Betrag einschließlich der aufgeführten Verzugskosten bis zum {faellig} zu überweisen.\n\nMit freundlichen Grüßen\n{firma}")
  dunningText3            String @default("Sehr geehrte Damen und Herren,\n\ndies ist unsere letzte Mahnung zur Rechnung {nummer}. Bitte überweisen Sie den Gesamtbetrag bis zum {faellig}. Geht die Zahlung bis dahin nicht ein, müssen wir ohne weitere Ankündigung rechtliche Schritte einleiten (z.B. ein gerichtliches Mahnverfahren), wodurch Ihnen weitere Kosten entstehen.\n\nMit freundlichen Grüßen\n{firma}")
  // Optisches Layout der PDFs: "CLEAR" (klar, viel Weiß), "BAND" (farbiges Kopfband) oder
  // "COMPACT" (Karten, kompakt) - siehe modules/pdf/documentTemplate.ts. Rein gestalterisch.
  pdfLayout     String   @default("CLEAR")
  // Standard-Begrüßung/-Schlusstext für neue Rechnungen und Angebote (Platzhalter z.B. {kunde},
  // {faellig}, {betrag}, {firma}). Wird beim Anlegen eines Belegs an diesen kopiert und kann dort
  // geändert werden; bereits versendete Belege behalten ihren Text (Unveränderbarkeit).
  invoiceIntroText   String @default("Sehr geehrte Damen und Herren,\n\nvielen Dank für Ihren Auftrag. Wir berechnen Ihnen folgende Leistungen:")
  invoiceClosingText String @default("Bitte überweisen Sie den Betrag bis zum {faellig} unter Angabe der Rechnungsnummer. Bei Fragen melden Sie sich gern.\n\nMit freundlichen Grüßen\n{firma}")
  quoteIntroText     String @default("Sehr geehrte Damen und Herren,\n\nvielen Dank für Ihre Anfrage. Wir unterbreiten Ihnen folgendes Angebot:")
  quoteClosingText   String @default("Dieses Angebot gilt bis zum {faellig}. Wir freuen uns auf Ihren Auftrag.\n\nMit freundlichen Grüßen\n{firma}")
  orderConfirmationIntroText   String @default("Sehr geehrte Damen und Herren,\n\nvielen Dank für Ihren Auftrag. Wir bestätigen Ihnen folgende Positionen:")
  orderConfirmationClosingText String @default("Wir kümmern uns um die Ausführung und melden uns bei Rückfragen.\n\nMit freundlichen Grüßen\n{firma}")
  deliveryNoteIntroText        String @default("Sehr geehrte Damen und Herren,\n\nwir liefern Ihnen folgende Positionen:")
  deliveryNoteClosingText      String @default("Bitte prüfen Sie die Lieferung auf Vollständigkeit und Unversehrtheit.\n\nMit freundlichen Grüßen\n{firma}")
  logoPath      String?
  stampPath     String? // Firmenstempel, wird automatisch auf PDFs eingefügt (siehe modules/pdf)
  signaturePath String? // Unterschrift (z.B. eingescannt), wird automatisch auf PDFs eingefügt
  primaryColor  String   @default("#2563eb")
  invoiceFooterText String?
  defaultLocale String   @default("de")

  // Eigene SMTP-Zugangsdaten je Firma für den E-Mail-Versand direkt aus der Software.
  // Jede Firma bringt ihr eigenes Postfach mit (Gmail, Web.de, Office365, Transaktions-
  // dienst, ...) - kein zentraler, gemeinsamer Mailserver. Passwort wird AES-256-GCM-
  // verschlüsselt abgelegt (siehe utils/crypto.ts), nie im Klartext zurückgegeben.
  // Ist kein SMTP hinterlegt, bleibt der PDF-Download die reguläre Versandart.
  smtpHost            String?
  smtpPort            Int?     @default(587)
  smtpSecure           Boolean  @default(false) // true = implizites TLS (Port 465), false = STARTTLS
  smtpUser             String?
  smtpPasswordEncrypted String?
  smtpFromEmail        String?
  smtpFromName         String?

  // Umsatzgrenzen für die Kleinunternehmerregelung (§19 UStG) seit der Reform zum
  // 1.1.2025: Vorjahresumsatz darf 25.000 € nicht überschritten haben, UND der Umsatz im
  // laufenden Kalenderjahr darf 100.000 € nicht übersteigen - wird Letzteres unterjährig
  // überschritten, entfällt die Steuerbefreiung ab genau diesem Umsatz sofort (nicht erst
  // im Folgejahr). Beide Werte konfigurierbar, falls sich die gesetzlichen Grenzen ändern.
  smallBusinessThresholdCents Int @default(2500000)
  smallBusinessCurrentYearThresholdCents Int @default(10000000)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users               User[]
  customers           Customer[]
  products            Product[]
  materials           Material[]
  invoices            Invoice[]
  quotes              Quote[]
  deliveryNotes       DeliveryNote[]
  orderConfirmations  OrderConfirmation[]
  numberSequences     NumberSequence[]
  printers            Printer[]
  archiveDocuments    ArchiveDocument[]
  assets              Asset[]
  suppliers           Supplier[]
  auditLogs           AuditLog[]
  dunnings            Dunning[]
  recurringInvoices   RecurringInvoice[]
  webhooks            Webhook[]
  settings            Setting[]
  expenses            Expense[]
}

// ---------- Benutzer & Zugriff ----------

// Hinweis: SQLite unterstützt keine nativen Enum-Typen in Prisma - daher werden Rollen-
// und Statuswerte als String mit anwendungsseitig geprüften Werten abgebildet (Validierung
// über Zod, siehe z.B. modules/users/router.ts). Bei Umstieg auf PostgreSQL könnten diese
// Felder optional wieder auf echte Prisma-Enums umgestellt werden.
// Erlaubte Werte für User.role: "ADMIN" | "MITARBEITER" | "BUCHHALTUNG"

model User {
  id                String   @id @default(uuid())
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId         String
  email             String   @unique
  passwordHash      String
  name              String
  role              String   @default("MITARBEITER")
  isActive          Boolean  @default(true)
  locale            String   @default("de")
  totpSecret        String? // verschlüsselt gespeichert (AES-256-GCM), siehe SECURITY.md
  totpEnabled       Boolean  @default(false)
  failedLoginCount  Int      @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  refreshTokens     RefreshToken[]
  passwordResets    PasswordResetToken[]
  auditLogs         AuditLog[]

  @@index([companyId])
}

model RefreshToken {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  tokenHash   String   @unique // nur SHA-256-Hash wird gespeichert, nie der Klartext-Token
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedBy  String?
  createdByIp String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

// Einmal-Link zum Zurücksetzen eines vergessenen Passworts (nur der SHA-256-Hash wird gespeichert, 1 Stunde gültig)
model PasswordResetToken {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------- Audit-Log (unveränderlich, jede Änderung wird protokolliert) ----------

model AuditLog {
  id         String   @id @default(uuid())
  company    Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  action     String // z.B. "invoice.create", "customer.update", "auth.login"
  entityType String
  entityId   String?
  ipAddress  String?
  metadata   String? // JSON-String mit Vorher/Nachher-Diff (ohne sensible Klartextdaten)
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
}

// ---------- Kunden ----------

model Customer {
  id            String   @id @default(uuid())
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     String
  customerNumber String
  type          String   @default("PRIVAT") // PRIVAT | GEWERBLICH
  name          String
  contactName   String?
  email         String?
  phone         String?
  street        String?
  postalCode    String?
  city          String?
  country       String   @default("DE")
  vatId         String?
  notes         String?
  // "Leitweg-ID" - von öffentlichen Auftraggebern (Bund/Länder/Kommunen) vergebene
  // Kennung, die eine E-Rechnung (XRechnung) als Buyer Reference (BT-10) enthalten MUSS,
  // damit sie automatisiert der richtigen Behörde/Kostenstelle zugeordnet werden kann.
  // Vom jeweiligen Auftraggeber mitgeteilt, nicht selbst erfunden - für normale
  // Privat-/Geschäftskunden ohne Leitweg-ID leer lassen.
  leitwegId     String?
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoices           Invoice[]
  quotes             Quote[]
  deliveryNotes      DeliveryNote[]
  orderConfirmations OrderConfirmation[]
  recurringInvoices  RecurringInvoice[]

  @@unique([companyId, customerNumber])
  @@index([companyId])
}

// ---------- Produkt-/Leistungsverzeichnis ----------

model Product {
  id            String   @id @default(uuid())
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     String
  sku           String?
  name          String
  description   String?
  unit          String   @default("Stk.")
  unitPriceCents Int
  vatRateBps    Int      @default(1900)
  // Kalkulation: Druck- und Arbeitszeit in Minuten pro verkaufter Einheit (siehe Company-Stundensätze)
  printTimeMinutes Float @default(0)
  laborMinutes     Float @default(0)
  // Auf welchem Drucker gedruckt wird (bestimmt Strom, Abschreibung, Verschleiß). Ohne Drucker gilt der pauschale Maschinenstundensatz.
  printer          Printer? @relation(fields: [printerId], references: [id], onDelete: SetNull)
  printerId        String?
  // Rüstzeit einmal je Auftrag (Slicen, Platte vorbereiten) in Minuten, Verpackung/Versand je Einheit in Cent,
  // zusätzlicher Materialverlust in Prozent (z.B. Spülmaterial bei Mehrfarbdruck) und Staffelpreise
  // ([{ minQuantity, unitPriceCents }], netto je Einheit ab dieser Menge).
  setupMinutes         Float @default(0)
  packagingCents       Int   @default(0)
  extraMaterialPercent Float @default(0)
  priceTiers           Json?
  // Druckplatte: Stück pro Platte (Zeit und Materialverbrauch werden auf der Platte erfasst und durch diese Zahl geteilt gespeichert)
  // und weitere Kosten je Stück als [{ label, amountCents }] (z.B. Lackieren, Klarlack, Magnete)
  piecesPerPlate       Int   @default(1)
  extraCosts           Json?
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoiceItems  InvoiceItem[]
  quoteItems    QuoteItem[]
  materials     ProductMaterial[]

  @@index([companyId])
}

// ---------- Material-/Lagerverwaltung ----------
// Rohstoffe (z.B. Filament), die für die Produktion verbraucht werden - getrennt von
// Product (das ist das, was verkauft wird). Über ProductMaterial hinterlegt man, wie viel
// von welchem Material ein Produkt pro verkaufter Einheit verbraucht ("Rezept"). Beim
// Erstellen einer Rechnung wird der Bestand automatisch entsprechend reduziert (siehe
// modules/invoices/router.ts), beim Löschen eines Entwurfs wieder gutgeschrieben.

model Material {
  id               String   @id @default(uuid())
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId        String
  name             String
  unit             String   @default("g")
  stockQuantity    Float    @default(0)
  // Zuletzt gezahlter Preis pro Einheit in Cent - wird bei jeder Nachbestellung/Anlage
  // aktualisiert, dient nur der Anzeige/Bewertung, nicht der exakten Einzelbuchführung.
  // Float statt Int, da bei kleinen Einheiten (z.B. Gramm) der Preis pro Einheit oft
  // deutlich unter einem Cent liegt (z.B. 24,99€/kg = 2,499 Cent/g) - ein ganzzahliger
  // Cent-Betrag würde hier sichtbar falsch runden.
  costPerUnitCents Float    @default(0)
  // Mindestbestand in Material.unit: fällt der Bestand darauf oder darunter, kommt einmal eine Meldung (lowStockNotifiedAt merkt sich das,
  // bis der Bestand wieder über der Grenze liegt). null/0 = keine Überwachung.
  minStock         Float?
  lowStockNotifiedAt DateTime?
  isArchived       Boolean  @default(false)
  // Bevorzugter Lieferant (wird bei Nachbestellungen als Händler der Ausgabe verwendet)
  supplier         Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierId       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products         ProductMaterial[]
  amsSlots         AmsSlotMapping[]

  @@index([companyId])
}

// 3D-Drucker (oder andere Maschinen) mit eigenen Kostenwerten für die Kalkulation
model Printer {
  id                 String   @id @default(uuid())
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId          String
  name               String
  purchasePriceCents Int      @default(0) // Anschaffungspreis
  lifetimeHours      Float    @default(5000) // geschätzte Lebensdauer in Druckstunden -> Abschreibung je Stunde
  usedHoursBefore    Float    @default(0) // vor der Erfassung schon gelaufene Betriebsstunden (z.B. gebraucht gekauft oder vor der Gewerbeanmeldung genutzt); die Restlebensdauer ist lifetimeHours minus dieser Wert
  powerWatts         Float    @default(120) // durchschnittliche Leistungsaufnahme beim Drucken -> Stromkosten
  wearCentsPerHour   Float    @default(10) // Verschleiß/Wartung (Düse, Bett, Riemen, Lager ...) je Druckstunde in Cent
  notes              String?
  // Live-Anbindung (nur lesend): NONE oder BAMBU_LAN (Bambu Lab im LAN-Modus). Der Zugangscode wird verschlüsselt gespeichert
  // und nie an den Browser ausgeliefert.
  connectionType     String   @default("NONE")
  model              String?
  host               String?
  serial             String?
  accessCodeEncrypted String?
  liveEnabled        Boolean  @default(false)
  isArchived         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  products           Product[]
  jobs               PrinterJob[]
  amsSlots           AmsSlotMapping[]

  @@index([companyId])
}

model ProductMaterial {
  id              String   @id @default(uuid())
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId       String
  material        Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId      String
  // Verbrauchte Menge (in Material.unit) pro einer verkauften Einheit des Produkts.
  quantityPerUnit Float
  // Eigener Preis je Material-Einheit nur für dieses Produkt (statt des Lagerpreises), z.B. für einen Sonderauftrag; null = Lagerpreis
  costOverrideCents Float?

  @@unique([productId, materialId])
  @@index([productId])
  @@index([materialId])
}

// ---------- Fortlaufende Belegnummern (pro Firma & Beleg-Typ) ----------

model NumberSequence {
  id         String  @id @default(uuid())
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  docType    String // INVOICE | QUOTE | DELIVERY_NOTE | ORDER_CONFIRMATION
  year       Int
  lastNumber Int     @default(0)
  prefix     String  @default("")

  @@unique([companyId, docType, year])
}

// ---------- Rechnungen ----------

// Erlaubte Werte für Invoice.status: "DRAFT" | "SENT" | "PAID" | "OVERDUE" | "CANCELLED"
// (siehe Hinweis zu Enums/SQLite oben bei Role)

model Invoice {
  id              String        @id @default(uuid())
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId       String
  customer        Customer      @relation(fields: [customerId], references: [id])
  customerId      String
  // NULL, solange die Rechnung ein Entwurf ist - die fortlaufende Nummer wird erst beim
  // ersten Verlassen von DRAFT (Versenden/als bezahlt markieren) vergeben (siehe
  // finalizeInvoiceNumber in modules/invoices/router.ts). So entsteht durch das Löschen
  // eines nie versendeten Entwurfs KEINE Lücke in der Nummernfolge (GoBD-Anforderung an
  // eine lückenlose Rechnungsnummerierung).
  invoiceNumber   String?
  status          String        @default("DRAFT")
  issueDate       DateTime      @default(now())
  dueDate         DateTime?
  deliveryDate    DateTime?
  isSmallBusiness Boolean       @default(false) // Kleinunternehmerregelung, eingefroren zum Erstellzeitpunkt
  // Zusätzlicher Pflicht-/Rechtshinweis auf dem PDF, wenn aus anderem Grund als der
  // Kleinunternehmerregelung 0% USt. ausgewiesen wird - "REVERSE_CHARGE" (innergemein-
  // schaftliche B2B-Leistung, Steuerschuldnerschaft des Leistungsempfängers, §13b UStG)
  // oder "EXPORT" (Ausfuhrlieferung in ein Nicht-EU-Land, §4 Nr. 1a UStG). NULL = normale
  // inländische Rechnung (oder Kleinunternehmer, dafür gibt es bereits isSmallBusiness).
  vatNoticeKey    String?
  // Art des Umsatzes: "GOODS" (Warenlieferung) oder "SERVICE" (sonstige Leistung). Entscheidet
  // bei Auslandskunden über die steuerliche Behandlung: Waren an EU-Unternehmer sind eine
  // steuerfreie innergemeinschaftliche Lieferung, Dienstleistungen unterliegen dem Reverse-
  // Charge-Verfahren - siehe modules/tax/euVat.ts.
  supplyType      String        @default("GOODS")
  currency        String        @default("EUR")
  subtotalCents   Int           @default(0)
  vatTotalCents   Int           @default(0)
  totalCents      Int           @default(0)
  paidAt          DateTime?
  notes           String?
  // Begrüßung über der Positionstabelle und Schlusstext unter den Summen (mit Platzhaltern, siehe
  // modules/pdf/placeholders.ts) - bis zum Versand änderbar, danach wie der ganze Beleg fest.
  introText       String?
  closingText     String?
  footerText      String?
  sourceQuoteId   String?
  sourceOrderConfirmationId String?
  // "STANDARD", "DOWN_PAYMENT" (Anzahlungs-/Abschlagsrechnung) oder "FINAL" (Schlussrechnung mit Abzug der Anzahlungen).
  // finalInvoiceId an einer Anzahlungsrechnung verweist auf die Schlussrechnung, in der sie bereits abgezogen wurde.
  kind            String        @default("STANDARD")
  finalInvoiceId  String?
  pdfPath         String?

  // Storno-/Korrekturbeleg (Gutschrift): Eine bereits versendete/bezahlte Rechnung wird
  // NIE gelöscht oder rückwirkend verändert (GoBD-Unveränderbarkeit) - stattdessen erzeugt
  // POST /:id/cancel eine neue, eigenständige Rechnung mit negierten Beträgen, eigener
  // fortlaufender Nummer und einem Verweis auf das Original. isCancellationDocument
  // markiert diesen Korrekturbeleg selbst (anderer PDF-Titel, kein Materialabzug, kein QR).
  correctsInvoiceId    String?
  correctsInvoice      Invoice?  @relation("InvoiceCorrections", fields: [correctsInvoiceId], references: [id])
  corrections          Invoice[] @relation("InvoiceCorrections")
  isCancellationDocument Boolean @default(false)

  // E-Mail-Versand (siehe modules/email/mailer.ts). "Zustell-Status" bildet ehrlich nur ab,
  // ob die Übergabe an den SMTP-Server der Firma erfolgreich war - keine Lesebestätigung.
  // Erlaubte Werte für emailStatus: "NOT_SENT" | "SENT" | "FAILED"
  emailStatus     String        @default("NOT_SENT")
  emailSentAt     DateTime?
  lastEmailError  String?

  // Mahnwesen: einfache Erinnerungsstufe + Zeitpunkt der letzten Erinnerung.
  reminderCount   Int           @default(0)
  lastReminderAt  DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           InvoiceItem[]
  dunnings        Dunning[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
}

model InvoiceItem {
  id             String   @id @default(uuid())
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      String
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId      String?
  position       Int
  description    String
  quantity       Float
  unit           String   @default("Stk.")
  unitPriceCents Int
  vatRateBps     Int
  lineTotalCents Int
  // Abzugsposition einer Schlussrechnung (negativer Betrag): bereits berechnete Anzahlung. In der XRechnung wird sie als
  // "bereits gezahlter Betrag" statt als negative Position übermittelt.
  isDownPaymentDeduction Boolean @default(false)
  deductsInvoiceId       String?

  @@index([invoiceId])
}

// ---------- Angebote ----------

// Erlaubte Werte für Quote.status: "DRAFT" | "SENT" | "ACCEPTED" | "DECLINED" | "EXPIRED"

model Quote {
  id            String      @id @default(uuid())
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     String
  customer      Customer    @relation(fields: [customerId], references: [id])
  customerId    String
  quoteNumber   String
  status        String      @default("DRAFT")
  issueDate     DateTime    @default(now())
  validUntil    DateTime?
  subtotalCents Int         @default(0)
  vatTotalCents Int         @default(0)
  totalCents    Int         @default(0)
  notes         String?
  introText     String?
  closingText   String?
  pdfPath       String?
  emailStatus   String      @default("NOT_SENT")
  emailSentAt   DateTime?
  lastEmailError String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items         QuoteItem[]

  @@unique([companyId, quoteNumber])
  @@index([companyId, status])
}

model QuoteItem {
  id             String  @id @default(uuid())
  quote          Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId        String
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId      String?
  position       Int
  description    String
  quantity       Float
  unit           String  @default("Stk.")
  unitPriceCents Int
  vatRateBps     Int
  lineTotalCents Int

  @@index([quoteId])
}

// ---------- Lieferscheine ----------

model DeliveryNote {
  id                        String              @id @default(uuid())
  company                   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId                 String
  customer                  Customer            @relation(fields: [customerId], references: [id])
  customerId                String
  noteNumber                String
  deliveryDate              DateTime            @default(now())
  notes                     String?
  // "DRAFT" (wird noch bearbeitet, PDF mit Entwurfs-Wasserzeichen) oder "SENT" (fertiggestellt)
  status                    String              @default("DRAFT")
  introText                 String?
  closingText               String?
  pdfPath                   String?
  sourceOrderConfirmation   OrderConfirmation?  @relation(fields: [sourceOrderConfirmationId], references: [id])
  sourceOrderConfirmationId String?
  // Lieferscheine sind zwar keine steuerpflichtigen Belege, aber nachvollziehbarkeits-
  // relevante Geschäftsunterlagen (GoBD) - "Löschen" markiert sie deshalb nur als
  // ungültig, statt den Datensatz zu entfernen (siehe modules/deliveryNotes/router.ts).
  voidedAt                  DateTime?
  // Wann der Beleg per E-Mail verschickt wurde (null = nicht per E-Mail versendet; "Fertigstellen" allein verschickt nichts)
  emailSentAt   DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  items        DeliveryNoteItem[]

  @@unique([companyId, noteNumber])
  @@index([companyId])
  @@index([sourceOrderConfirmationId])
}

model DeliveryNoteItem {
  id             String       @id @default(uuid())
  deliveryNote   DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  deliveryNoteId String
  position       Int
  description    String
  quantity       Float
  unit           String       @default("Stk.")

  @@index([deliveryNoteId])
}

// ---------- Auftragsbestätigungen ----------

model OrderConfirmation {
  id            String   @id @default(uuid())
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     String
  customer      Customer @relation(fields: [customerId], references: [id])
  customerId    String
  confirmationNumber String
  issueDate     DateTime @default(now())
  expectedDeliveryDate DateTime?
  subtotalCents Int      @default(0)
  vatTotalCents Int      @default(0)
  totalCents    Int      @default(0)
  notes         String?
  // "DRAFT" oder "SENT" - siehe DeliveryNote.status
  status        String   @default("DRAFT")
  introText     String?
  closingText   String?
  sourceQuoteId String?
  pdfPath       String?
  // Siehe Kommentar bei DeliveryNote.voidedAt - gleiches Prinzip.
  voidedAt      DateTime?
  // Produktionsboard: CREATED -> IN_PRODUCTION -> READY_TO_SHIP -> SHIPPED (siehe modules/production)
  productionStatus    String    @default("CREATED")
  productionNote      String?
  productionUpdatedAt DateTime?
  shippedAt           DateTime?
  // Wann der Beleg per E-Mail verschickt wurde (null = nicht per E-Mail versendet; "Fertigstellen" allein verschickt nichts)
  emailSentAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         OrderConfirmationItem[]
  deliveryNotes DeliveryNote[]
  printerJobs   PrinterJob[]

  @@unique([companyId, confirmationNumber])
  @@index([companyId])
}

model OrderConfirmationItem {
  id                  String            @id @default(uuid())
  orderConfirmation   OrderConfirmation @relation(fields: [orderConfirmationId], references: [id], onDelete: Cascade)
  orderConfirmationId String
  position            Int
  description         String
  quantity            Float
  unit                String            @default("Stk.")
  unitPriceCents      Int
  vatRateBps          Int
  lineTotalCents      Int

  @@index([orderConfirmationId])
}

// ---------- Einstellungen (Key-Value je Firma, für Plugins & Konfiguration) ----------

model Setting {
  id        String  @id @default(uuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  key       String
  value     String // JSON-String
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
}

// ---------- Webhooks (Erweiterbarkeit) ----------

model Webhook {
  id         String   @id @default(uuid())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  url        String
  secret     String // HMAC-Signatur der Payload, siehe docs/API.md
  eventTypes String // kommagetrennte Liste, z.B. "invoice.created,invoice.paid"
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([companyId])
}

model WebhookDelivery {
  id           String   @id @default(uuid())
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  webhookId    String
  eventType    String
  payload      String
  responseCode Int?
  success      Boolean  @default(false)
  attemptedAt  DateTime @default(now())

  @@index([webhookId])
}

// ---------- Ausgaben & Einnahmen-Überschuss-Rechnung (EÜR) ----------

model Expense {
  id            String   @id @default(uuid())
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     String
  date          DateTime @default(now())
  vendor        String // Händler/Lieferant
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierId    String?
  category      String   @default("Sonstiges") // z.B. "Material", "Software", "Fahrtkosten"
  amountCents   Int // Bruttobetrag der Ausgabe
  vatRateBps    Int      @default(1900)
  description   String?
  receiptPath   String? // hochgeladener Beleg (Foto/Scan), siehe modules/expenses
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId, date])
}

// ---------- Bankabgleich per Kontoauszugs-Import (CSV) ----------
// Kein Live-Zugriff auf das Bankkonto (das würde einen kostenpflichtigen PSD2-Aggregator
// wie FinAPI erfordern) - stattdessen wird ein vom Nutzer exportierter CSV-Kontoauszug
// importiert und automatisch mit offenen Rechnungen abgeglichen (Betrag + Verwendungszweck).

model BankTransaction {
  id           String   @id @default(uuid())
  companyId    String
  bookingDate  DateTime
  amountCents  Int // positiv = Zahlungseingang
  purpose      String? // Verwendungszweck
  counterparty String?
  matchedInvoiceId String?
  importedAt   DateTime @default(now())

  @@index([companyId, bookingDate])
}

// ---------- Mahnwesen ----------
// Jede erzeugte Zahlungserinnerung/Mahnung wird mit den berechneten Beträgen und dem Wortlaut festgehalten
// (Handelsbrief, nachweispflichtig). Beträge sind kumulativ: Gebühren und Pauschale früherer Stufen sind enthalten.

model Dunning {
  id              String   @id @default(uuid())
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId       String
  level           Int // 1 = Zahlungserinnerung, 2 = 1. Mahnung, 3 = 2. (letzte) Mahnung
  principalCents  Int // offene Rechnungssumme
  feeCents        Int // Mahngebühren (kumulativ)
  interestCents   Int // Verzugszinsen bis zum Mahndatum
  flatFeeCents    Int // Verzugskostenpauschale §288 Abs. 5 BGB (nur B2B, einmalig)
  totalCents      Int
  interestRateBps Int // Jahreszins in Basispunkten
  daysOverdue     Int
  newDueDate      DateTime
  text            String
  pdfPath         String?
  sentByEmail     Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([invoiceId])
  @@index([companyId, createdAt])
}

// ---------- Wiederkehrende Rechnungen ----------
// Eine Vorlage erzeugt zu jedem Fälligkeitstermin automatisch einen Rechnungs-ENTWURF (nie eine versendete Rechnung) -
// die Rechnung wird erst nach Prüfung per "Fertigstellen" ausgestellt (GoBD: Nummer erst bei Ausstellung).

model RecurringInvoice {
  id            String    @id @default(uuid())
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     String
  customer      Customer  @relation(fields: [customerId], references: [id])
  customerId    String
  name          String // interne Bezeichnung, z.B. "Monatliche Wartung Industrie AG"
  intervalUnit  String // WEEK | MONTH | QUARTER | YEAR
  intervalCount Int       @default(1)
  nextRunDate   DateTime
  endDate       DateTime?
  isActive      Boolean   @default(true)
  supplyType    String    @default("GOODS")
  notes         String?
  introText     String?
  closingText   String?
  itemsJson     String // JSON-Array der Positionen (description, quantity, unit, unitPriceCents, vatRateBps, productId?)
  lastRunAt     DateTime?
  lastInvoiceId String?
  runCount      Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId, isActive, nextRunDate])
}

// ---------- Belegarchiv ----------
// Eigene Ablage für Dokumente des Unternehmens (Eingangsrechnungen, Quittungen, Verträge, Bescheide ...) als PDF, Foto
// oder Office-Datei. Die Datei liegt unter UPLOAD_DIR/archive/<Firma>/; contentText enthält den aus PDFs/Textdateien
// gelesenen Text für die Volltextsuche. sha256 erkennt doppelt hochgeladene Dateien.

model ArchiveDocument {
  id           String   @id @default(uuid())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId    String
  title        String
  category     String   @default("SONSTIGES")
  documentDate DateTime @default(now())
  vendor       String? // Aussteller/Absender
  amountCents  Int?
  notes        String?
  tags         String[] @default([])
  fileName     String
  filePath     String
  mimeType     String
  sizeBytes    Int
  sha256       String
  contentText  String?
  // Stammt aus dem Beleg einer Ausgabe (Finanzen → Ausgaben); bewusst ohne Fremdschlüssel: das Archiv-Dokument bleibt auch bestehen, wenn die Ausgabe gelöscht wird.
  expenseId    String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId, documentDate])
  @@index([companyId, sha256])
}

// ---------- Anlageverzeichnis (Abschreibung/AfA) ----------
// Anlagegüter wie Drucker oder Werkzeug. Bei der EÜR zählt statt der vollen Anschaffung die jährliche Abschreibung (AfA) bzw.
// bei GWG der Sofortabzug. Ist expenseId gesetzt, wird die verknüpfte Ausgabe in der EÜR nicht zusätzlich gezählt.
// Anschaffungskosten: bei Kleinunternehmern brutto, sonst netto.

model Asset {
  id               String   @id @default(uuid())
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId        String
  name             String
  purchaseDate     DateTime
  costCents        Int
  method           String   @default("LINEAR") // GWG | LINEAR
  usefulLifeYears  Int?
  expenseId        String?  @unique
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([companyId, purchaseDate])
}

// ---------- Lieferanten ----------
// Händler und Hersteller, bei denen eingekauft wird (Filament, Ersatzteile, Verpackung ...). Ausgaben und Materialien können
// einem Lieferanten zugeordnet werden - daraus entsteht die Übersicht "Wie viel habe ich wo ausgegeben".

model Supplier {
  id             String   @id @default(uuid())
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId      String
  name           String
  contactName    String?
  email          String?
  phone          String?
  website        String?
  street         String?
  postalCode     String?
  city           String?
  country        String?
  customerNumber String? // Ihre Kundennummer bei diesem Lieferanten
  notes          String?
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  expenses       Expense[]
  materials      Material[]

  @@index([companyId])
}

// Druckaufträge, die über die Live-Anbindung erkannt wurden (Start, Ende, Ergebnis) - Grundlage für die Betriebsstunden je Drucker.
model PrinterJob {
  id        String    @id @default(uuid())
  companyId String
  printer   Printer   @relation(fields: [printerId], references: [id], onDelete: Cascade)
  printerId String
  name      String?
  startedAt DateTime
  endedAt   DateTime?
  result    String? // FINISHED | FAILED | CANCELLED | UNKNOWN
  minutes   Int? // Dauer inklusive Pausen
  // Aus dem AMS gemessener Materialverbrauch dieses Drucks: [{ materialId, name, grams }]
  materialUsage Json?
  // Aus der 3MF-Datei (Slicer-Angabe) erwarteter Verbrauch je Fach, solange noch nicht abgebucht: [{ filament, slot, grams }]
  slicedPlan Json?
  // Zugeordneter Auftrag (Auftragsbestätigung): Druckzeit und Material gehen in die Ist-Kosten des Auftrags ein
  orderConfirmation   OrderConfirmation? @relation(fields: [orderConfirmationId], references: [id], onDelete: SetNull)
  orderConfirmationId String?

  @@index([printerId, startedAt])
  @@index([orderConfirmationId])
  @@index([companyId])
}

// ---------- Automatische Materialabbuchung aus dem AMS ----------
// Ordnet einem AMS-Fach eines Druckers ein Material zu. Der Drucker meldet bei Bambu-Spulen mit Chip den Füllstand in Prozent;
// sinkt er, wird die Differenz (mal Spulengewicht) vom Materialbestand abgezogen. lastRemain/lastTag sind der zuletzt verbuchte
// Stand - so wird nichts doppelt gebucht, und ein Spulenwechsel (andere Chip-Kennung) setzt nur den Ausgangswert neu.
model AmsSlotMapping {
  id         String   @id @default(uuid())
  companyId  String
  printer    Printer  @relation(fields: [printerId], references: [id], onDelete: Cascade)
  printerId  String
  slot       Int // AMS-Einheit * 4 + Fach (0-15)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId String
  spoolGrams Int      @default(1000) // Füllgewicht einer vollen Spule
  lastRemain Int?
  lastTag    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([printerId, slot])
  @@index([materialId])
  @@index([companyId])
}

// ---------- Materialabbuchung nach Slicer-Angabe (für Spulen ohne Chip) ----------
// Wird beim Senden eines Drucks aus der App angelegt: welches Filament der 3MF-Datei in welchem Fach liegt und wie viele Gramm der Slicer
// dafür berechnet hat. Beginnt am Drucker ein Auftrag mit demselben Namen, wandert der Plan in PrinterJob.slicedPlan und wird bei
// Druckende abgebucht.
model PrintPlan {
  id        String   @id @default(uuid())
  companyId String
  printerId String
  jobName   String // normalisierter Dateiname (ohne .gcode.3mf, kleingeschrieben)
  entries   Json // [{ filament, slot, grams }]
  orderConfirmationId String? // beim Senden gewählter Auftrag, wird an den Druckauftrag weitergegeben
  createdAt DateTime @default(now())

  @@index([printerId, jobName])
  @@index([companyId])
}

// ---------- Meldungen (z.B. Druck fertig/fehlgeschlagen) ----------
model Notification {
  id        String    @id @default(uuid())
  companyId String
  type      String // PRINT_FINISHED | PRINT_FAILED | PRINTER_ERROR
  title     String
  body      String
  printerId String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([companyId, createdAt])
}

// ---------- Push-Nachrichten (Web Push) ----------
model PushSubscription {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([companyId])
}
