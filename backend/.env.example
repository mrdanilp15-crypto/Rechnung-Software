# Datenbank: Standard SQLite (portabel). Für Produktion/Mehrbenutzer: PostgreSQL empfohlen.
# SQLite: Prisma löst diesen relativen Pfad IMMER relativ zu backend/prisma/schema.prisma
# auf, nicht relativ zum Arbeitsverzeichnis - die Datei landet also unter
# backend/prisma/data/app.db.
# SQLite:      DATABASE_URL="file:./data/app.db"
# PostgreSQL:  DATABASE_URL="postgresql://user:password@localhost:5432/rechnung?schema=public"
DATABASE_URL="file:./data/app.db"

NODE_ENV=development
PORT=4000
PUBLIC_APP_URL="http://localhost:5173"

# JWT (mind. 32 Byte Zufallswert, z.B. `openssl rand -base64 48`)
JWT_ACCESS_SECRET="change-me-access-secret-min-32-bytes-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-bytes-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# AES-256-GCM Schlüssel zur Verschlüsselung sensibler Felder (TOTP-Secrets etc.)
# 32 Byte, Base64-kodiert, z.B. `openssl rand -base64 32`
FIELD_ENCRYPTION_KEY="change-me-32-byte-base64-encryption-key===="

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# CORS - kommagetrennte Liste erlaubter Origins
CORS_ORIGINS="http://localhost:5173"

# Backups
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=30

# Optionaler S3-kompatibler Cloud-Speicher für Backups (leer lassen = deaktiviert)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="eu-central-1"

# Uploads (Logos etc.)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=5

# Logging
LOG_LEVEL="info"
