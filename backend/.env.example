# Für den normalen Betrieb (Docker Compose / Portainer) wird DATABASE_URL bereits von
# docker-compose.yml gesetzt - diese Datei ist nur für lokale Entwicklung OHNE Docker
# gegen eine eigene, lokal installierte PostgreSQL-Instanz gedacht.
DATABASE_URL="postgresql://user:password@localhost:5432/rechnung?schema=public"

NODE_ENV=development
PORT=4000
PUBLIC_APP_URL="http://localhost:5173"

# JWT (mind. 32 Byte Zufallswert, z.B. `openssl rand -base64 48`)
JWT_ACCESS_SECRET="change-me-access-secret-min-32-bytes-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-bytes-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# AES-256-GCM Schlüssel zur Verschlüsselung sensibler Felder (TOTP-Secrets etc.)
# 32 Byte, Base64-kodiert, z.B. `openssl rand -base64 32`
FIELD_ENCRYPTION_KEY="change-me-32-byte-base64-encryption-key===="

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# CORS - kommagetrennte Liste erlaubter Origins
CORS_ORIGINS="http://localhost:5173"

# Backups (laufen automatisch im Hintergrund, siehe src/index.ts + modules/backup/runBackup.ts)
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=30
BACKUP_AUTO_ENABLED=true
BACKUP_INTERVAL_HOURS=24

# Optionaler S3-kompatibler Cloud-Speicher für Backups (leer lassen = deaktiviert)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="eu-central-1"

# Uploads (Logos etc.)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=5

# Logging
LOG_LEVEL="info"
