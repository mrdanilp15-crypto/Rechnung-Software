# Vorlage für die Umgebungsvariablen von docker-compose.yml.
#
# Lokal mit `docker compose up -d`: diese Datei nach ".env" kopieren (bleibt dank
# .gitignore lokal, wird nie committet) und Werte anpassen.
#
# In Portainer: die Variablen unten beim Anlegen des Stacks unter "Environment
# variables" eintragen (oder den Inhalt dieser Datei dort per "Advanced mode" /
# .env-Upload einfügen, je nach Portainer-Version).
#
# Alles hier ist OPTIONAL - ohne jede Anpassung startet der Stack trotzdem lauffähig
# (mit einem Standard-DB-Passwort und automatisch erzeugten, dauerhaft gespeicherten
# Sicherheits-Secrets). Für einen öffentlich erreichbaren Server werden die unten
# markierten Werte trotzdem empfohlen.

# Port, unter dem die Anwendung im Browser erreichbar ist (http://<server>:<port>)
FRONTEND_PORT=8080

# Öffentliche URL der Anwendung und erlaubte CORS-Origin - bei einer eigenen
# Domain/einem Reverse-Proxy hier die tatsächliche URL eintragen, z.B.
# PUBLIC_APP_URL=https://rechnung.meine-firma.de
# CORS_ORIGINS=https://rechnung.meine-firma.de
PUBLIC_APP_URL=
CORS_ORIGINS=

# --- Empfohlen für echten Produktivbetrieb (sonst werden Standard-/Zufallswerte genutzt) ---

# Datenbank-Zugangsdaten (nur intern im Docker-Netzwerk erreichbar, aber trotzdem: eigenes
# Passwort setzen, bevor die Instanz produktiv genutzt wird)
POSTGRES_USER=rechnung
POSTGRES_PASSWORD=
POSTGRES_DB=rechnung

# Signatur-/Verschlüsselungs-Secrets. Leer lassen = werden beim ersten Start automatisch
# erzeugt und dauerhaft in einem Docker-Volume gespeichert - explizites Setzen ist nur
# nötig, wenn eigene, versionierte Werte gewünscht sind (z.B. `openssl rand -base64 48`).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
FIELD_ENCRYPTION_KEY=

# Ohne diesen Wert ist die "Registrieren"-Seite für jeden im Internet offen und legt
# eine komplett neue, unabhängige Firma auf dieser Instanz an. Sobald der eigene erste
# Admin-Account eingerichtet ist, hier einen zufälligen Wert setzen (z.B.
# `openssl rand -hex 16`) - danach ist ohnehin kein weiteres /register mehr nötig.
REGISTRATION_INVITE_CODE=

# --- Optional ---

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# Automatische Backups (ZIP mit Datenbank-Dump + Uploads, siehe backend/backups-Volume).
# Aufbewahrung standardmäßig 10 Jahre (GoBD-Aufbewahrungsfrist), Backups werden per
# AES-256-GCM verschlüsselt (BACKUP_ENCRYPTION_ENABLED=false zum Deaktivieren).
BACKUP_AUTO_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=3650
BACKUP_ENCRYPTION_ENABLED=true

# Optionaler S3-kompatibler Cloud-Speicher für Backups (leer lassen = deaktiviert)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=eu-central-1

MAX_UPLOAD_MB=5
LOG_LEVEL=info
# LOG_DIR wird von docker-compose.yml bereits auf /app/logs (eigenes Volume) gesetzt,
# damit Logs einen Container-Neustart überleben - hier nur für den lokalen Betrieb ohne
# Docker relevant, leer lassen = nur Konsolenausgabe wie bisher.
LOG_DIR=
